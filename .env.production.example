# Production settings. Copy to .env.production, fill every value, and keep that file OUT of git
# (it is ignored). It holds secrets. Generate each secret with:  openssl rand -base64 48
#
# Check it before you start the stack:
#   docker compose -f compose.prod.yaml --env-file .env.production run --rm api python -m pv_api.cli check-config

# ---- what is being deployed (set by deploy/deploy.sh to the git commit)
IMAGE_TAG=

# ---- where people reach it
# The domain name that points at this machine. The proxy gets a certificate for it by itself.
SITE_ADDRESS=app.example.com
PUBLIC_BASE_URL=https://app.example.com
# Only change these if 80 and 443 are taken on the machine.
HTTP_PORT=80
HTTPS_PORT=443

# ---- database. Two different roles: the owner runs migrations, the app role cannot bypass security.
POSTGRES_USER=provenance
POSTGRES_DB=provenance
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# ---- secrets. Each at least 32 characters, never reused, never shared.
SECRET_KEY=
# Keys that seal connector tokens, newest first, comma separated. To rotate: put a new key first,
# keep the old one behind it, deploy, run `reseal-tokens`, then remove the old one (runbook: secret rotation).
TOKEN_ENCRYPTION_KEYS=

# ---- who may sign up and what is required
SIGNUP_MODE=invite
EMAIL_VERIFICATION_REQUIRED=true

# ---- email. A real provider (Resend, Brevo, or your own). Password reset and verification need it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=Provenance <no-reply@app.example.com>

# ---- the model. Use a paid plan whose terms say inputs are not used to train models (C-42).
GEMINI_API_KEY=
LLM_MODEL=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIMENSIONS=768
# Prices in USD per million tokens, from the provider official pricing page.
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
LLM_EMBEDDING_PRICE_PER_MILLION=0
# The Health page alerts at 80 percent of this much model spend in a day. 0 means no ceiling.
LLM_DAILY_SPEND_CEILING_USD=0

# ---- optional
DEFAULT_PLAN=free
REPORT_RETENTION_DAYS=7
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LOG_LEVEL=INFO
