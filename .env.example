# Copy to .env and edit. Never commit .env.
# Use letters and digits only in passwords (they are embedded in URLs).

ENVIRONMENT=development

# Database owner (used only by migrations)
POSTGRES_USER=provenance
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=provenance

# Application role (used by the API and the worker). Must be a different role from the owner.
APP_DB_PASSWORD=change-me-app-password

# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-value-before-use

# URLs for tools you run on your machine (uv run alembic, uv run pytest).
# Inside Docker, compose.yaml builds its own URLs that point at the "postgres" host.
# Keep the passwords below identical to the two passwords above.
DATABASE_URL=postgresql+psycopg://provenance_app:change-me-app-password@localhost:5433/provenance
MIGRATION_DATABASE_URL=postgresql+psycopg://provenance:change-me-owner-password@localhost:5433/provenance

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# ---- Authentication (checkpoints 1.2 and 1.3)
# invite: only people with an invite code can sign up. open: anyone can.
SIGNUP_MODE=invite
# false while developing. Set true in production once mail delivery works.
EMAIL_VERIFICATION_REQUIRED=false
# Where the web app is served. Used in email links and for the Origin check.
PUBLIC_BASE_URL=http://localhost:5173

# ---- Mail (checkpoint 1.4)
# Development default: the Mailpit container that is part of the compose stack.
# Emails are queued, the worker sends them to Mailpit, and you read them at http://localhost:8025.
# To write emails to the worker log instead, leave SMTP_HOST empty (SMTP_HOST=).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=Provenance <no-reply@localhost>
DEV_INBOX_URL=http://localhost:8025
# Mailpit image tag. Checked against the official release list on 2026-10-22.
MAILPIT_TAG=v1.30.5

# ---- Worker (checkpoint 1.4). Defaults are fine for development.
# WORKER_POLL_INTERVAL_SECONDS=1.0
# Visibility timeout: seconds a claimed task stays hidden before another worker may take it.
# WORKER_LEASE_SECONDS=120
# WORKER_HEARTBEAT_SECONDS=10
# TASK_RETENTION_DAYS=7

# ---- AI provider (Gemini free tier, development only; use only your own test data)
# Free-tier prompts may be used by the provider to improve its products.
# Create a key in Google AI Studio, then run: .\scripts\pv.ps1 ai-check
# That command lists the model names your key can use. Put chosen names below.
GEMINI_API_KEY=
LLM_MODEL=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIMENSIONS=768
# Free tiers limit requests per minute. Seconds to wait between calls (for example 4).
LLM_MIN_INTERVAL_SECONDS=0
# Prices in USD per million tokens, copied from the provider's official pricing page.
# Leave 0 until you have checked them: the cost shown is then 0, never a guess.
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
LLM_EMBEDDING_PRICE_PER_MILLION=0
