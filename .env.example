# Copy to .env and edit. Never commit .env.
# Use letters and digits only in passwords (they are embedded in URLs).

ENVIRONMENT=development

# Database owner (used only by migrations)
POSTGRES_USER=provenance
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=provenance

# Application role (used by the API). Must be a different role from the owner.
APP_DB_PASSWORD=change-me-app-password

# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-value-before-use

# URLs for tools you run on your machine (uv run alembic, uv run pytest).
# Inside Docker, compose.yaml builds its own URLs that point at the "postgres" host.
# Keep the passwords below identical to the two passwords above.
DATABASE_URL=postgresql+psycopg://provenance_app:change-me-app-password@localhost:5433/provenance
MIGRATION_DATABASE_URL=postgresql+psycopg://provenance:change-me-owner-password@localhost:5433/provenance

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# ---- Authentication (checkpoints 1.2 and 1.3)
# invite: only people with an invite code can sign up. open: anyone can.
SIGNUP_MODE=invite
# false while developing. Set true in production once mail delivery works.
EMAIL_VERIFICATION_REQUIRED=false
# Where the web app is served. Used in email links and for the Origin check.
PUBLIC_BASE_URL=http://localhost:5173

# ---- Mail (leave SMTP_HOST empty in development: emails are written to the API log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=Provenance <no-reply@localhost>
# Only for the optional local inbox (docker compose --profile mail up). Verify the tag on Docker Hub.
MAILPIT_TAG=v1.21.8
